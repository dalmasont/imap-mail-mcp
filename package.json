{
  "name": "imap-mail-mcp",
  "version": "0.1.0",
  "description": "Remote MCP server for IMAP mailboxes (read, search, move, delete to Trash), hosted on Cloudflare Workers",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "test": "bun test",
    "typecheck": "wrangler types && npx -p typescript@5 tsc -p tsconfig.json && npx -p typescript@5 tsc -p tsconfig.test.json",
    "lint": "biome check ."
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.1",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "^0.24.0",
    "cf-imap": "^1.0.0",
    "fast-xml-parser": "^5.11.1",
    "ical.js": "^2.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "wrangler": "^4.143.0"
  }
}
